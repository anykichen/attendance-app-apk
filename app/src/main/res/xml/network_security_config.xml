<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 允许 http 明文访问内网IP（Android 9+ 默认禁止明文，必须声明） -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
